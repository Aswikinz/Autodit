{
  "name": "autodit",
  "services": {
    "postgres": {
      "image": "docker.io/library/postgres:17-bookworm",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_USER": "autodit_owner",
        "POSTGRES_DB": "autodit",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_password",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256"
      },
      "secrets": [
        {
          "source": "autodit_db_password",
          "target": "db_password"
        },
        {
          "source": "autodit_app_password",
          "target": "app_password"
        }
      ],
      "volumes": [
        "postgres_data:/var/lib/postgresql/data",
        "../templates/postgres-init.sh:/docker-entrypoint-initdb.d/10-app.sh:ro"
      ],
      "networks": [
        "audit"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U autodit_owner -d autodit"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 30
      },
      "logging": {
        "driver": "k8s-file",
        "options": {
          "max-size": "10m"
        }
      }
    },
    "migrate": {
      "image": "localhost/autodit:0.1.0",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=128m"
      ],
      "environment": {
        "POSTGRES_HOST": "postgres:5432",
        "POSTGRES_DB": "autodit",
        "POSTGRES_USER": "autodit_owner",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_password",
        "AUTODIT_TENANT_ID": "${AUTODIT_TENANT_ID:-11111111-1111-4111-8111-111111111111}",
        "AUTODIT_TENANT_NAME": "${AUTODIT_TENANT_NAME:-Audit workspace}",
        "AUTODIT_AUTH_MODE": "${AUTODIT_AUTH_MODE:-local}",
        "AUTODIT_PUBLIC_URL": "${AUTODIT_PUBLIC_URL:-http://localhost:8088}",
        "AUTODIT_ADMIN_PASSWORD_FILE": "/run/secrets/admin_password",
        "AUTODIT_DEMO_TOKEN_FILE": "/run/secrets/demo_token",
        "AUTODIT_OIDC_ISSUER": "${AUTODIT_OIDC_ISSUER:-}",
        "AUTODIT_OIDC_CLIENT_ID": "${AUTODIT_OIDC_CLIENT_ID:-}",
        "AUTODIT_OIDC_CLIENT_SECRET_FILE": "/run/secrets/oidc_secret"
      },
      "secrets": [
        {
          "source": "autodit_db_password",
          "target": "db_password"
        },
        {
          "source": "autodit_app_password",
          "target": "app_password"
        },
        {
          "source": "autodit_demo_token",
          "target": "demo_token"
        },
        {
          "source": "autodit_oidc_secret",
          "target": "oidc_secret"
        },
        {
          "source": "autodit_admin_password",
          "target": "admin_password"
        }
      ],
      "networks": [
        "audit"
      ],
      "volumes": [
        "snapshots:/data/snapshots"
      ],
      "logging": {
        "driver": "k8s-file",
        "options": {
          "max-size": "10m"
        }
      },
      "command": [
        "migrate"
      ],
      "profiles": [
        "setup"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      }
    },
    "bootstrap": {
      "image": "localhost/autodit:0.1.0",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=128m"
      ],
      "environment": {
        "POSTGRES_HOST": "postgres:5432",
        "POSTGRES_DB": "autodit",
        "POSTGRES_USER": "autodit_app",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/app_password",
        "AUTODIT_TENANT_ID": "${AUTODIT_TENANT_ID:-11111111-1111-4111-8111-111111111111}",
        "AUTODIT_TENANT_NAME": "${AUTODIT_TENANT_NAME:-Audit workspace}",
        "AUTODIT_AUTH_MODE": "${AUTODIT_AUTH_MODE:-local}",
        "AUTODIT_PUBLIC_URL": "${AUTODIT_PUBLIC_URL:-http://localhost:8088}",
        "AUTODIT_ADMIN_PASSWORD_FILE": "/run/secrets/admin_password",
        "AUTODIT_DEMO_TOKEN_FILE": "/run/secrets/demo_token",
        "AUTODIT_OIDC_ISSUER": "${AUTODIT_OIDC_ISSUER:-}",
        "AUTODIT_OIDC_CLIENT_ID": "${AUTODIT_OIDC_CLIENT_ID:-}",
        "AUTODIT_OIDC_CLIENT_SECRET_FILE": "/run/secrets/oidc_secret"
      },
      "secrets": [
        {
          "source": "autodit_app_password",
          "target": "app_password"
        },
        {
          "source": "autodit_demo_token",
          "target": "demo_token"
        },
        {
          "source": "autodit_oidc_secret",
          "target": "oidc_secret"
        },
        {
          "source": "autodit_admin_password",
          "target": "admin_password"
        }
      ],
      "networks": [
        "audit"
      ],
      "volumes": [
        "snapshots:/data/snapshots"
      ],
      "logging": {
        "driver": "k8s-file",
        "options": {
          "max-size": "10m"
        }
      },
      "command": [
        "bootstrap"
      ],
      "profiles": [
        "setup"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      }
    },
    "api": {
      "image": "localhost/autodit:0.1.0",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=128m"
      ],
      "environment": {
        "POSTGRES_HOST": "postgres:5432",
        "POSTGRES_DB": "autodit",
        "POSTGRES_USER": "autodit_app",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/app_password",
        "AUTODIT_TENANT_ID": "${AUTODIT_TENANT_ID:-11111111-1111-4111-8111-111111111111}",
        "AUTODIT_TENANT_NAME": "${AUTODIT_TENANT_NAME:-Audit workspace}",
        "AUTODIT_AUTH_MODE": "${AUTODIT_AUTH_MODE:-local}",
        "AUTODIT_PUBLIC_URL": "${AUTODIT_PUBLIC_URL:-http://localhost:8088}",
        "AUTODIT_ADMIN_PASSWORD_FILE": "/run/secrets/admin_password",
        "AUTODIT_DEMO_TOKEN_FILE": "/run/secrets/demo_token",
        "AUTODIT_OIDC_ISSUER": "${AUTODIT_OIDC_ISSUER:-}",
        "AUTODIT_OIDC_CLIENT_ID": "${AUTODIT_OIDC_CLIENT_ID:-}",
        "AUTODIT_OIDC_CLIENT_SECRET_FILE": "/run/secrets/oidc_secret"
      },
      "secrets": [
        {
          "source": "autodit_app_password",
          "target": "app_password"
        },
        {
          "source": "autodit_demo_token",
          "target": "demo_token"
        },
        {
          "source": "autodit_oidc_secret",
          "target": "oidc_secret"
        },
        {
          "source": "autodit_admin_password",
          "target": "admin_password"
        }
      ],
      "networks": [
        "audit"
      ],
      "volumes": [
        "snapshots:/data/snapshots"
      ],
      "logging": {
        "driver": "k8s-file",
        "options": {
          "max-size": "10m"
        }
      },
      "command": [
        "api"
      ],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD",
          "audit",
          "healthcheck"
        ],
        "interval": "10s",
        "timeout": "4s",
        "retries": 12
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      }
    },
    "worker": {
      "image": "localhost/autodit:0.1.0",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=128m"
      ],
      "environment": {
        "POSTGRES_HOST": "postgres:5432",
        "POSTGRES_DB": "autodit",
        "POSTGRES_USER": "autodit_app",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/app_password",
        "AUTODIT_TENANT_ID": "${AUTODIT_TENANT_ID:-11111111-1111-4111-8111-111111111111}",
        "AUTODIT_TENANT_NAME": "${AUTODIT_TENANT_NAME:-Audit workspace}",
        "AUTODIT_AUTH_MODE": "${AUTODIT_AUTH_MODE:-local}",
        "AUTODIT_PUBLIC_URL": "${AUTODIT_PUBLIC_URL:-http://localhost:8088}",
        "AUTODIT_ADMIN_PASSWORD_FILE": "/run/secrets/admin_password",
        "AUTODIT_DEMO_TOKEN_FILE": "/run/secrets/demo_token",
        "AUTODIT_OIDC_ISSUER": "${AUTODIT_OIDC_ISSUER:-}",
        "AUTODIT_OIDC_CLIENT_ID": "${AUTODIT_OIDC_CLIENT_ID:-}",
        "AUTODIT_OIDC_CLIENT_SECRET_FILE": "/run/secrets/oidc_secret",
        "AUTODIT_INBOX_DIR": "/data/inbox"
      },
      "secrets": [
        {
          "source": "autodit_app_password",
          "target": "app_password"
        },
        {
          "source": "autodit_demo_token",
          "target": "demo_token"
        },
        {
          "source": "autodit_oidc_secret",
          "target": "oidc_secret"
        },
        {
          "source": "autodit_admin_password",
          "target": "admin_password"
        }
      ],
      "networks": [
        "audit"
      ],
      "volumes": [
        "snapshots:/data/snapshots",
        "../../inbox:/data/inbox:ro"
      ],
      "logging": {
        "driver": "k8s-file",
        "options": {
          "max-size": "10m"
        }
      },
      "command": [
        "worker"
      ],
      "restart": "unless-stopped",
      "stop_grace_period": "120s",
      "depends_on": {
        "api": {
          "condition": "service_healthy"
        }
      }
    },
    "proxy": {
      "image": "localhost/autodit-proxy:0.1.0",
      "restart": "unless-stopped",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=32m"
      ],
      "ports": [
        "${AUTODIT_BIND:-127.0.0.1}:${AUTODIT_PORT:-8088}:8080"
      ],
      "networks": [
        "audit",
        "ingress"
      ],
      "depends_on": {
        "api": {
          "condition": "service_healthy"
        }
      },
      "logging": {
        "driver": "k8s-file",
        "options": {
          "max-size": "10m"
        }
      }
    }
  },
  "volumes": {
    "postgres_data": {},
    "snapshots": {}
  },
  "networks": {
    "audit": {
      "internal": true
    },
    "ingress": {}
  },
  "secrets": {
    "autodit_db_password": {
      "external": true
    },
    "autodit_app_password": {
      "external": true
    },
    "autodit_demo_token": {
      "external": true
    },
    "autodit_oidc_secret": {
      "external": true
    },
    "autodit_admin_password": {
      "external": true
    }
  }
}
