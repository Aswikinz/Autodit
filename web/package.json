{
  "name": "autodit-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "api-gen": "openapi-typescript ../internal/api/openapi.json -o src/api/schema.ts && prettier --write src/api/schema.ts",
    "test": "vitest run src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gorules/jdm-editor": "1.52.0",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "8.21.3",
    "lucide-react": "1.46.0",
    "monaco-editor": "0.52.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
