FROM docker.io/library/golang:1.27-bookworm AS build
ENV GOMAXPROCS=2
WORKDIR /build
# Keep upstream Caddy pinned while applying published dependency security fixes.
RUN go mod init autodit-proxy-build \
    && go get github.com/caddyserver/caddy/v2/cmd/caddy@v2.11.4 \
        golang.org/x/text@v0.41.0 google.golang.org/grpc@v1.83.2 go.opentelemetry.io/otel@v1.44.0 \
        github.com/klauspost/compress@v1.18.7 \
    && CGO_ENABLED=0 go build -trimpath -o /go/bin/caddy github.com/caddyserver/caddy/v2/cmd/caddy
FROM docker.io/library/debian:bookworm-slim
RUN groupadd --gid 10001 auditproxy && useradd --uid 10001 --gid auditproxy --no-create-home auditproxy
COPY --from=build /go/bin/caddy /usr/local/bin/caddy
COPY deploy/templates/Caddyfile /etc/caddy/Caddyfile
USER 10001:10001
ENV XDG_CONFIG_HOME=/tmp/config XDG_DATA_HOME=/tmp/data
EXPOSE 8080
ENTRYPOINT ["caddy","run","--config","/etc/caddy/Caddyfile","--adapter","caddyfile"]
