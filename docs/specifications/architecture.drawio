  </diagram>

  <diagram id="deployment-architecture" name="3. Deployment Architecture">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="d_t" value="Deployment Architecture — single client-provided VM, air-gap capable" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="d_t2" value="Podman/Buildah build → signed OCI images → offline bundle → client registry → Compose on one VM. Helm/k3s path retained for scale-out." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1000" height="20" as="geometry" />
        </mxCell>

        <!-- vendor zone -->
        <mxCell id="d_vendor" value="VENDOR BUILD &amp; RELEASE (outside client perimeter)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#4A6FA5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#2C4A78;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d_v1" value="CI build&#10;Podman / Buildah&#10;3 images: api · worker · migrate&#10;base: debian-slim (NOT alpine — cgo/musl)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A6FA5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d_v2" value="Supply-chain artefacts&#10;cosign signatures&#10;syft SBOM (SPDX)&#10;trivy pre-scan report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A6FA5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d_v3" value="Offline bundle&#10;skopeo copy --all --preserve-digests&#10;+ compose file / Helm chart&#10;+ dbt project + rule pack (JDM JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A6FA5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="130" width="250" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d_v4" value="Physical / approved transfer&#10;no egress from client cluster · no licence phone-home · no telemetry to vendor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#B07A2A;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="130" width="250" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d_v5" value="Versioning rule&#10;app version == chart/compose version.&#10;migrate job REFUSES to run if schema is &gt;1 minor version behind." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#B07A2A;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="130" width="380" height="86" as="geometry" />
        </mxCell>
        <mxCell id="dv_e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#374151;" edge="1" parent="1" source="d_v1" target="d_v2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dv_e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#374151;" edge="1" parent="1" source="d_v2" target="d_v3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dv_e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#374151;" edge="1" parent="1" source="d_v3" target="d_v4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- client perimeter -->
        <mxCell id="d_client" value="CLIENT PERIMETER — all data remains inside" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFB;strokeColor=#374151;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#1F2937;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1560" height="790" as="geometry" />
        </mxCell>

        <mxCell id="d_reg" value="Internal registry&#10;Harbor / Artifactory&#10;images pinned by digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF7;strokeColor=#4A6FA5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- the VM -->
        <mxCell id="d_vm" value="APPLICATION VM  —  client-provided  ·  RHEL 9 / Ubuntu 22.04  ·  8 vCPU / 32 GB RAM / 500 GB SSD  ·  Podman + Compose under systemd" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF6FB;strokeColor=#2E7A9E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#1D5670;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="330" width="900" height="470" as="geometry" />
        </mxCell>

        <mxCell id="d_net" value="Container network (internal) — only caddy publishes a host port" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#4B5563;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="368" y="366" width="500" height="18" as="geometry" />
        </mxCell>

        <mxCell id="d_caddy" value="caddy&#10;:443 published" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6F76;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="368" y="392" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_api" value="audit-api&#10;Go + ZEN + UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4FB;strokeColor=#2E7A9E;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="538" y="392" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_wrk" value="audit-worker × 2–6&#10;extract / dbt / DuckDB / score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2EC;strokeColor=#2E7D5B;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="708" y="392" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_mig" value="migrate&#10;(run-once, pre-start)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6F76;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="908" y="392" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_zit" value="zitadel&#10;OIDC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F2;strokeColor=#6B6F76;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1078" y="392" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d_pg" value="postgres&#10;system of record + River queue&#10;volume: pgdata (WAL archiving on)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#FDF3E3;strokeColor=#B07A2A;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="480" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d_minio" value="minio&#10;Parquet snapshots + evidence&#10;volume: objects (versioning + retention lock)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#FDF3E3;strokeColor=#B07A2A;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="480" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d_obs" value="otel-collector + openobserve&#10;ops telemetry only · capped retention&#10;volume: obs (size-limited)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F2;strokeColor=#6B6F76;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="930" y="480" width="298" height="100" as="geometry" />
        </mxCell>

        <mxCell id="d_hard" value="HOST HARDENING &amp; CONTROLS&#10;· rootless Podman, non-root UID in container, readOnlyRootFilesystem, dropped caps, seccomp RuntimeDefault&#10;· default-deny egress; explicit allowlist per source system endpoint&#10;· secrets from host file mounts or External Secrets / Vault (optional, never mandatory)&#10;· disk quota + log retention caps so a runaway log cannot take Postgres down with the VM&#10;· LVM snapshot or pg_basebackup + MinIO mirror to the client backup target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#B07A2A;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="610" width="848" height="130" as="geometry" />
        </mxCell>
        <mxCell id="d_scale" value="SCALE PATH:  vertical (more vCPU/RAM) → worker replica count → split Postgres to a managed/HA instance → k3s + Helm chart (already built) for the rare large client" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1D5670;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="380" y="752" width="848" height="30" as="geometry" />
        </mxCell>

        <!-- source zone -->
        <mxCell id="d_srcz" value="SOURCE SYSTEM ZONE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F7F5;strokeColor=#2E7D5B;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#1E5940;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="240" height="290" as="geometry" />
        </mxCell>
        <mxCell id="d_s1" value="SAP — CDS/OData, SLT replica,&#10;or ABAP extract to SFTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D5B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="96" y="486" width="208" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d_s2" value="Core banking — EOD extract&#10;gated on COB completion signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D5B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="96" y="554" width="208" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d_s3" value="Data warehouse / ODS&#10;read-only account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D5B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="96" y="622" width="208" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d_s4" value="SFTP drop (client-hosted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D5B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="96" y="690" width="208" height="38" as="geometry" />
        </mxCell>

        <!-- enterprise services -->
        <mxCell id="d_entz" value="CLIENT ENTERPRISE SERVICES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F7;strokeColor=#6B6F76;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#4B4F55;" vertex="1" parent="1">
          <mxGeometry x="1290" y="330" width="280" height="410" as="geometry" />
        </mxCell>
        <mxCell id="d_e1" value="Entra ID / Okta / ADFS&#10;upstream IdP (SAML or OIDC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6F76;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1306" y="366" width="248" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d_e2" value="SIEM — Splunk / QRadar&#10;syslog or OTLP forward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6F76;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1306" y="434" width="248" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d_e3" value="Backup target&#10;pg WAL + MinIO mirror&#10;retention aligned to audit record policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6F76;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1306" y="502" width="248" height="66" as="geometry" />
        </mxCell>
        <mxCell id="d_e4" value="Vault / secret store&#10;optional — file-mounted secrets supported" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6F76;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1306" y="580" width="248" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d_e5" value="SMTP relay&#10;exception alerts / deadman notices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6F76;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1306" y="648" width="248" height="56" as="geometry" />
        </mxCell>

        <mxCell id="d_users" value="Auditors · Audit Managers · CAE&#10;corporate workstations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF7;strokeColor=#4A6FA5;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="850" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d_note" value="WHY ONE VM WORKS:  typical client volume is 0.5–5 M journal lines per period. Postgres with correct indexes plus DuckDB over Parquet handles this comfortably within the stated sizing. The constraint that bites first is RAM, not CPU — Zitadel (Go, ~200 MB) rather than Keycloak (JVM, ~1 GB+) is a deliberate choice for this reason." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6FB;strokeColor=#2E7A9E;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="830" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d_note2" value="SINGLE POINT OF FAILURE — ACKNOWLEDGED:  one VM means no HA. Mitigation is RPO/RTO by backup and rebuild-from-bundle (target RTO &lt; 4 h), not clustering. Continuous auditing is a detective control, not a real-time transaction path, so a few hours of outage is tolerable — but this must be stated in the contract, not assumed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE9E9;strokeColor=#A8433F;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="990" y="830" width="500" height="100" as="geometry" />
        </mxCell>

