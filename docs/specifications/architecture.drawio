        <mxCell id="c_api5" value="Generates Sling YAML / dlt config from stored source definitions · proxies internal service APIs so users never leave the single origin" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="418" y="372" width="564" height="40" as="geometry" />
        </mxCell>

        <mxCell id="c_worker" value="audit-worker  (same image, worker entrypoint · N replicas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2EC;strokeColor=#2E7D5B;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="600" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c_w1" value="Sling&#10;DB + file extract" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D5B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="98" y="540" width="135" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c_w2" value="dlt&#10;REST / OData" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D5B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="245" y="540" width="135" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c_w3" value="dbt-core&#10;raw → canonical" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFE8F7;strokeColor=#6B4A9E;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="392" y="540" width="135" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c_w4" value="DuckDB&#10;set-based analytics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE9E9;strokeColor=#A8433F;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="539" y="540" width="123" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c_w5" value="River worker pool — pulls periodic + ad-hoc jobs from Postgres. Pipeline: extract → tie-out → snapshot to Parquet → dbt → DuckDB analytics → ZEN scoring → exception reconciliation." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="98" y="596" width="564" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_w6" value="NOTE: dlt requires a Python runtime in the image — the one deviation from a pure single-binary build." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#A8433F;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="98" y="648" width="564" height="24" as="geometry" />
        </mxCell>

        <mxCell id="c_pg" value="PostgreSQL 16&#10;system of record · River queue&#10;raw + canonical + exceptions + audit trail" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#FDF3E3;strokeColor=#B07A2A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="760" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_minio" value="MinIO (S3)&#10;Parquet snapshots&#10;evidence &amp; attachments" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#FDF3E3;strokeColor=#B07A2A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="760" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c_zitadel" value="Zitadel (Go)&#10;OIDC provider · SAML/OIDC federation&#10;own Postgres schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F2;strokeColor=#6B6F76;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="280" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_idp" value="Client IdP&#10;Entra ID / Okta / ADFS&#10;(external — upstream federation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1380" y="280" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c_otel" value="OTel Collector&#10;OTLP receive · redact · route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F2;strokeColor=#6B6F76;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="450" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_o2" value="OpenObserve&#10;logs + metrics + traces, single Go binary, built-in UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F2;strokeColor=#6B6F76;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="550" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_siem" value="Client SIEM&#10;Splunk / QRadar&#10;(external)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1380" y="550" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c_src" value="Source Systems&#10;SAP · core banking · DW/ODS · SFTP&#10;(external — allowlisted egress only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="770" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c_jdm" value="JDM Editor (React, MIT)&#10;embedded in Rule Catalog screen · emits JDM JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE9E9;strokeColor=#A8433F;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#374151;endArrow=block;endFill=1;" edge="1" parent="1" source="c_browser" target="c_proxy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce1b" value="HTTPS 443" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ce1"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#374151;endArrow=block;endFill=1;" edge="1" parent="1" source="c_proxy" target="c_api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#374151;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c_api" target="c_zitadel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce3b" value="OIDC" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ce3"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#374151;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c_zitadel" target="c_idp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce4b" value="SAML / OIDC federation" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ce4"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
        <mxCell id="ce5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B07A2A;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c_api" target="c_pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B07A2A;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c_worker" target="c_pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B07A2A;endArrow=block;endFill=1;" edge="1" parent="1" source="c_worker" target="c_minio"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E7D5B;endArrow=block;endFill=1;" edge="1" parent="1" source="c_worker" target="c_src"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce8b" value="read-only extract" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ce8"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
        <mxCell id="ce9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B6F76;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c_api" target="c_otel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B6F76;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c_worker" target="c_otel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B6F76;endArrow=block;endFill=1;" edge="1" parent="1" source="c_otel" target="c_o2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B6F76;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c_otel" target="c_siem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce12b" value="syslog / OTLP forward" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ce12"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
